{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windsurf Cascade Proxy",
  "version": "0.2.0",
  "identifier": "cn.windsurf-cascade.proxy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windsurf Cascade 代理",
        "width": 1320,
        "height": 840,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "resources": {
      "../../../packages/proxy-core/app-config.mjs": "proxy-core/app-config.mjs",
      "../../../packages/proxy-core/cli.mjs": "proxy-core/cli.mjs",
      "../../../packages/proxy-core/known-windsurf-builds.json": "proxy-core/known-windsurf-builds.json",
      "../../../packages/proxy-core/package.json": "proxy-core/package.json",
      "../../../packages/proxy-core/patch.mjs": "proxy-core/patch.mjs",
      "../../../packages/proxy-core/server.mjs": "proxy-core/server.mjs",
      "../../../packages/proxy-core/upstream.mjs": "proxy-core/upstream.mjs",
      "../../../packages/proxy-core/src/": "proxy-core/src/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
